;;; herdr-core-gui-smoke.el --- Standalone graphical smoke test -*- lexical-binding: t; -*-
;; Run in a fresh graphical Emacs with Ghostel on load-path, never in a user's
;; existing Emacs.  Uses the isolated Core fixture; writes FLEET_GUI_RESULT.
(require 'herdr-core-live-test)
(require 'agent-fleet-dashboard)
(require 'agent-fleet-attach)
(require 'agent-fleet-magit)
(require 'agent-fleet-details)
(require 'agent-fleet-batch)
(declare-function ghostel-send-string "ghostel" (string))
(declare-function evil-mode "evil-core" (&optional arg))
(declare-function evil-set-initial-state "evil-core" (mode state))
(defvar evil-want-keybinding)

(defun fleet-gui-smoke-run ()
  "Exercise real frames, Ghostel attachment, PTY size and detach."
  (let ((result-file (or (getenv "FLEET_GUI_RESULT") "/tmp/fleet-gui-result"))
        (code 0) (report "") viewers)
    (condition-case err
        (hc-live-isolated
          (unless (display-graphic-p) (error "Graphical Emacs is required"))
          (unless (agent-fleet-attach--ghostel-ready-p) (error "Ghostel is unavailable"))
          (setq evil-want-keybinding nil)
          (when (require 'evil nil t)
            (evil-set-initial-state 'special-mode 'motion)
            (evil-mode 1)
            (setq report (concat report "Evil enabled for real GUI command bindings.\n")))
          (global-set-key (kbd "C-c a") agent-fleet-command-map)
          (let ((agent-fleet--last-command nil))
            (should
             (equal (minibuffer-with-setup-hook
                        (lambda ()
                          (setq unread-command-events
                                (append (listify-key-sequence "sh -c \"sleep 60\"\r")
                                        unread-command-events)))
                      (agent-fleet--read-command))
                    '("sh" "-c" "sleep 60"))))
          (setq report (concat report "Command minibuffer preserves typed spaces and quoted arguments.\n"))
          (let* ((origin (selected-frame))
                 (origin-buffer (get-buffer-create "*Smoke Origin*"))
                 (record (herdr-core-request
                          "terminal.run"
                          (list :argv ["sh" "-c" "printf 'ready\n'; seq 1 100; sleep 60"] :cwd root
                                :no_parent t :labels '(:fleet.role "agent"))))
                 (address (plist-get record :address)))
            (switch-to-buffer origin-buffer)
            (hc-live-until (lambda () (herdr-core-terminal address)))
            (agent-fleet)
            (should (equal "Type" (car (aref tabulated-list-format 1))))
            (should (equal "sh" (aref (cadar tabulated-list-entries) 1)))
            (sit-for 0.2)
            (should (eq (selected-frame) origin))
            (agent-fleet)
            (should-error (agent-fleet-dashboard--visit (lambda () (error "expected failure"))))
            (should (derived-mode-p 'agent-fleet-mode))
            (agent-fleet-dashboard-focus address)
            (call-interactively (key-binding (kbd "RET")))
            (should (eq (selected-frame) origin))
            (let* ((viewer (current-buffer)) (reference agent-fleet-target)
                   (process (get-buffer-process viewer)))
              (push viewer viewers)
              (should agent-fleet-attach-mode)
              (should (process-live-p process))
              (sit-for 0.4)
              (agent-fleet-attach reference)
              (should (eq viewer (current-buffer)))
              (goto-char (point-min))
              (set-window-start nil (point-min) t)
              (sit-for 0.2)
              (let ((position (point)) (start (window-start)))
                (agent-fleet)
                (sit-for 0.2)
                (agent-fleet-dashboard-quit)
                (sit-for 0.2)
                (should (= position (point)))
                (should (= start (window-start))))
              ;; Same-window review must never change the underlying PTY size.
              (let* ((before (herdr-core-request "terminal.get" (list :terminal address)))
                     (frames (frame-list)) (window (selected-window)) size-events
                     (herdr-core-event-hook
                      (cons (lambda (event)
                              (when (and (equal (plist-get event :type) "size")
                                         (equal (plist-get event :terminal) address))
                                (push event size-events)))
                            herdr-core-event-hook)))
                (agent-fleet)
                (sit-for 0.2)
                (should (eq (selected-window) window))
                (should (equal frames (frame-list)))
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal (plist-get before :cols) (plist-get after :cols)))
                  (should (equal (plist-get before :rows) (plist-get after :rows))))
                (call-interactively (key-binding (kbd "C-c a p")))
                (should (derived-mode-p 'agent-fleet-prompt-mode))
                (should (equal agent-fleet-target reference))
                (should-not (frame-parameter nil 'agent-fleet-auxiliary-frame))
                (call-interactively (key-binding (kbd "C-c C-k")))
                (should (derived-mode-p 'agent-fleet-mode))
                (call-interactively (key-binding (kbd "n")))
                (should (derived-mode-p 'agent-fleet-start-mode))
                (call-interactively (key-binding (kbd "C-c C-k")))
                (should (derived-mode-p 'agent-fleet-mode))
                (call-interactively (key-binding (kbd "q")))
                (sit-for 0.2)
                (should (eq (current-buffer) viewer))
                (should (process-live-p process))
                (should-not size-events)
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal (plist-get before :cols) (plist-get after :cols)))
                  (should (equal (plist-get before :rows) (plist-get after :rows)))))
              (setq report (concat report "Same-window Dashboard, nested return, viewer retention and unchanged PTY size passed.\n"))
              (let* ((agent-fleet-commands '("sh -c \"sleep 60\""))
                     (agent-fleet--last-command nil)
                     (form (agent-fleet-start-form))
                     (child (selected-frame)) new-address)
                (call-interactively (key-binding (kbd "C-c C-c")))
                (hc-live-until (lambda () (eq agent-fleet-operation-state 'started)))
                (should (eq (current-buffer) form))
                (setq new-address (plist-get agent-fleet-operation-result :address))
                (call-interactively (key-binding (kbd "C-c C-a")))
                (push (current-buffer) viewers)
                (should (eq (selected-frame) origin))
                (should-not (frame-live-p child))
                (should-not (eq (current-buffer) viewer))
                (should (process-live-p process))
                (agent-fleet-attach reference)
                (herdr-core-request "terminal.kill" (list :terminal new-address))
                (hc-live-until
                 (lambda () (equal "finished" (plist-get (herdr-core-terminal new-address) :state))))
                (agent-fleet-present-buffer form)
                (setq child (selected-frame))
                (should-error (agent-fleet--start-form-attach) :type 'user-error)
                (should (eq (selected-frame) child))
                (should (eq (current-buffer) form))
                (should (frame-live-p child))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (agent-fleet-view-quit))
              (setq report (concat report "Launch result stays visible; origin attach and failure retention passed.\n"))
              (let* ((record (cl-find-if (lambda (r) (equal (plist-get r :state) "finished"))
                                        (agent-fleet-agents t)))
                     (form (agent-fleet-prompt (agent-fleet-reference record) "Retained draft"))
                     (child (selected-frame)))
                (call-interactively (key-binding (kbd "C-c C-c")))
                (hc-live-until (lambda () (eq agent-fleet-operation-state 'rejected)))
                (should (eq (current-buffer) form))
                (should (eq (selected-frame) child))
                (should (equal (buffer-string) "Retained draft"))
                (should (string-match-p "finished"
                                        (overlay-get agent-fleet-prompt--status-overlay 'before-string)))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (call-interactively (key-binding (kbd "C-c C-k"))))
              (setq report (concat report "Prompt rejection retains draft, diagnostics, focus and attached viewer.\n"))
              (let* ((batch (agent-fleet-start-batch
                             (list (list :argv '("sh" "-c" "sleep 60") :cwd root :name "batch-smoke")
                                   (list :argv '("true") :cwd root :name "-invalid"))))
                     (child (selected-frame)) new-address)
                (call-interactively (key-binding (kbd "C-c C-c")))
                (hc-live-until
                 (lambda () (equal (mapcar (lambda (entry) (plist-get entry :state)) agent-fleet-batch--entries)
                                   '(started failed))))
                (setq new-address (plist-get (plist-get (car agent-fleet-batch--entries) :record) :address))
                (call-interactively (key-binding (kbd "n")))
                (should-error (call-interactively (key-binding (kbd "RET"))) :type 'user-error)
                (should (eq (selected-frame) child))
                (call-interactively (key-binding (kbd "p")))
                (call-interactively (key-binding (kbd "i")))
                (should (derived-mode-p 'agent-fleet-details-mode))
                (should (equal new-address (plist-get (agent-fleet-resolve agent-fleet-target) :address)))
                (agent-fleet-view-quit)
                (agent-fleet-present-buffer batch)
                (setq child (selected-frame))
                (call-interactively (key-binding (kbd "RET")))
                (push (current-buffer) viewers)
                (should-not (frame-live-p child))
                (should (eq (selected-frame) origin))
                (should (process-live-p process))
                (agent-fleet-attach reference)
                (herdr-core-request "terminal.kill" (list :terminal new-address))
                (hc-live-until (lambda () (equal "finished" (plist-get (herdr-core-terminal new-address) :state)))))
              (setq report (concat report "Batch mixed results, row actions, failure retention and origin attach passed.\n"))
              (agent-fleet-cleanup)
              (let ((child (selected-frame))
                    (item (get-text-property (point) 'fleet-cleanup-item)))
                (should item)
                (should (frame-parameter nil 'agent-fleet-auxiliary-frame))
                (call-interactively (key-binding (kbd "SPC")))
                (should-not (plist-get item :selected))
                (call-interactively (key-binding (kbd "SPC")))
                (should (plist-get item :selected))
                (call-interactively (key-binding (kbd "C-c C-c")))
                (should (eq (plist-get item :status) 'removed))
                (should (eq (selected-frame) child))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (call-interactively (key-binding (kbd "q"))))
              (setq report (concat report "Cleanup initial selection and results preserve the attached viewer.\n"))
              (let ((before (herdr-core-request "terminal.get" (list :terminal address))))
                (agent-fleet)
                (call-interactively (key-binding (kbd "i")))
                (should (derived-mode-p 'agent-fleet-details-mode))
                (should (equal agent-fleet-target reference))
                (should (string-match-p "Type +sh" (buffer-string)))
                (should (string-match-p "Type source +Launch command" (buffer-string)))
                (let ((child (selected-frame)) (details (current-buffer)))
                  (call-interactively (key-binding (kbd "g")))
                  (should (eq (current-buffer) details))
                  (should (eq (selected-frame) child))
                  (call-interactively (key-binding (kbd "p")))
                  (should (derived-mode-p 'agent-fleet-prompt-mode))
                  (should (equal agent-fleet-target reference))
                  (call-interactively (key-binding (kbd "C-c C-k")))
                  (should (derived-mode-p 'agent-fleet-details-mode))
                  (agent-fleet-view-quit)
                  (agent-fleet-dashboard-quit)
                  (should (eq (current-buffer) viewer))
                  (agent-fleet-details reference)
                  (should (eq (current-buffer) details))
                  (call-interactively (key-binding (kbd "o")))
                  (should (derived-mode-p 'agent-fleet-output-mode))
                  (call-interactively (key-binding (kbd "q")))
                  (agent-fleet-details reference)
                  (setq child (selected-frame))
                  (call-interactively (key-binding (kbd "RET")))
                  (should-not (frame-live-p child))
                  (should (eq (current-buffer) viewer)))
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal (plist-get before :cols) (plist-get after :cols)))
                  (should (equal (plist-get before :rows) (plist-get after :rows)))))
              (setq report (concat report "Details refresh, actions and reuse preserve target, origin and PTY geometry.\n"))
              (let* ((before (herdr-core-request "terminal.get" (list :terminal address)))
                     (cols (plist-get before :cols)) (rows (plist-get before :rows)))
                (agent-fleet-show-output reference)
                (sit-for 0.2)
                (should (frame-parameter nil 'agent-fleet-auxiliary-frame))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (let ((child (selected-frame)) (buffer (current-buffer)))
                  (call-interactively (key-binding (kbd "g")))
                  (should (eq (selected-frame) child))
                  (should (eq (current-buffer) buffer))
                  (should (string-match-p "ready" (buffer-string))))
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal cols (plist-get after :cols)))
                  (should (equal rows (plist-get after :rows))))
                ;; Opening Dashboard from an auxiliary view must retain the
                ;; real origin window, not adopt the auxiliary window.
                (let ((auxiliary (selected-frame)))
                  (agent-fleet)
                  (should (eq (selected-frame) origin))
                  (should-not (frame-live-p auxiliary))
                  (agent-fleet-dashboard-quit))
                (agent-fleet-view-quit)
                (should (eq (current-buffer) viewer))
                (set-frame-size origin (+ (frame-width origin) 4) (+ (frame-height origin) 2))
                (sit-for 0.3)
                (hc-live-until
                 (lambda ()
                   (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                     (not (and (equal cols (plist-get after :cols))
                               (equal rows (plist-get after :rows))))))))
              (when (require 'magit nil t)
                (let ((default-directory root)) (call-process "git" nil nil nil "init" "-q"))
                (agent-fleet-magit-status reference)
                (should (frame-parameter nil 'agent-fleet-auxiliary-frame))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (agent-fleet-display-close-auxiliary-frame (selected-frame))
                (setq report (concat report "Magit auxiliary review passed.\n")))
              ;; A new Emacs frame initially displays the current buffer.
              ;; Do not briefly put the interactive viewer in a smaller frame.
              (switch-to-buffer origin-buffer)
              (let* ((observer-frame (make-frame '((width . 55) (height . 16))))
                     before observer)
                (unwind-protect
                    (progn
                      (set-window-buffer (frame-selected-window observer-frame) origin-buffer)
                      (select-frame-set-input-focus origin)
                      (switch-to-buffer viewer)
                      (sit-for 0.3)
                      (setq before (herdr-core-request "terminal.get" (list :terminal address)))
                      (select-frame-set-input-focus observer-frame)
                      (agent-fleet-observe reference)
                      (setq observer (current-buffer))
                      (push observer viewers)
                      (should agent-fleet-observe-p)
                      (should-not (eq observer viewer))
                      (sit-for 0.4)
                      (agent-fleet-observe reference)
                      (should (eq observer (current-buffer)))
                      (ghostel-send-string "OBSERVER-MUST-NOT-TYPE\n")
                      (set-frame-size observer-frame 65 19)
                      (sit-for 0.4)
                      (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                        (should (equal (plist-get before :cols) (plist-get after :cols)))
                        (should (equal (plist-get before :rows) (plist-get after :rows))))
                      (should-not (string-match-p "OBSERVER-MUST-NOT-TYPE"
                                                  (plist-get (herdr-core-request "terminal.read"
                                                                                (list :terminal address)) :text))))
                  (when (buffer-live-p observer)
                    (let ((kill-buffer-query-functions nil)) (kill-buffer observer)))
                  (delete-frame observer-frame)
                  (select-frame-set-input-focus origin)))
              (setq report (concat report "Observer reuse, input isolation, focus and resize isolation passed.\n"))
              (let ((kill-buffer-query-functions nil)) (kill-buffer viewer))
              (sit-for 0.2)
              (should (equal "live" (plist-get (herdr-core-request
                                              "terminal.get" (list :terminal address)) :state)))
              (should (buffer-live-p origin-buffer)))
            (herdr-core-request "terminal.kill" (list :terminal address))
            (setq report (concat report "Centering, focus, repeated open, failure retention, attach, output geometry, parent resize and detach passed.\n"))))
      ((error quit)
       (setq code 1 report
             (concat report (format "FAILED: %S\nBuffer: %S Window: %S\n"
                                     err (buffer-name) (buffer-name (window-buffer)))))))
    (dolist (buffer viewers)
      (when (buffer-live-p buffer)
        (let ((kill-buffer-query-functions nil)) (kill-buffer buffer))))
    (with-temp-file result-file (insert report))
    (kill-emacs code)))
(run-at-time 0.5 nil #'fleet-gui-smoke-run)
