;;; herdr-core-gui-smoke.el --- Standalone graphical smoke test -*- lexical-binding: t; -*-
;; Run in a fresh graphical Emacs with Ghostel on load-path, never in a user's
;; existing Emacs.  Uses the isolated Core fixture; writes FLEET_GUI_RESULT.
(require 'herdr-core-live-test)
(require 'agent-fleet-dashboard)
(require 'agent-fleet-attach)
(require 'agent-fleet-magit)
(require 'agent-fleet-details)
(declare-function ghostel-send-string "ghostel" (string))
(declare-function ghostel-char-mode "ghostel" ())
(declare-function ghostel-emacs-mode "ghostel" (&optional sticky))
(declare-function ghostel--desired-size "ghostel" ())
(declare-function ghostel--set-title "ghostel" (title))
(declare-function evil-mode "evil-core" (&optional arg))
(declare-function evil-set-initial-state "evil-core" (mode state))
(declare-function magit-mode-bury-buffer "magit-mode" (&optional kill-buffer))
(declare-function magit-status "magit-status" (&optional directory))
(defvar evil-want-keybinding)
(defvar magit-display-buffer-function)

(defun fleet-gui-check-quiet-resize (directory)
  "Check rendered width after closing a right-hand Magit in DIRECTORY.
The fixture emits a delayed resize frame and then stops producing output."
  (let* ((record (herdr-core-request
                  "terminal.run"
                  (list :argv (vector (executable-find "python3")
                                      (expand-file-name "resize-screen.py"
                                                        (file-name-directory (locate-library "herdr-core-gui-smoke"))))
                        :cwd directory :no_parent t :labels '(:fleet.role "agent"))))
         (reference (agent-fleet-reference record)) viewer)
    (unwind-protect
        (progn
          (agent-fleet-attach reference)
          (setq viewer (current-buffer))
          (let ((default-directory directory)) (call-process "git" nil nil nil "init" "-q"))
          (dolist (close '(magit-mode-bury-buffer delete-window restore))
            (let* ((window (selected-window))
                   (full-size (with-current-buffer viewer (ghostel--desired-size)))
                   (full-width (window-body-width window))
                   (configuration (current-window-configuration))
                   (process (get-buffer-process viewer))
                   (magit-display-buffer-function
                    (lambda (buffer)
                      (display-buffer buffer `((display-buffer-in-direction) (direction . right) (window . ,window))))))
              (magit-status directory)
              (hc-live-until
               (lambda ()
                 (redisplay t)
                 (with-current-buffer viewer
                   (let ((size (ghostel--desired-size)))
                     (and (< (window-body-width window) full-width)
                          (< (car size) (car full-size))
                          (string-match-p (format "SIZE %s %s" (car size) (cdr size)) (buffer-string)))))))
              (pcase close
                ('magit-mode-bury-buffer (magit-mode-bury-buffer))
                ('delete-window (delete-window))
                ('restore (set-window-configuration configuration)))
              (select-window window)
              (set-buffer viewer)
              (ert-info ((format "Quiet resize after %s" close))
                (hc-live-until
                 (lambda ()
                   (redisplay t)
                   (and (= (window-body-width window) full-width)
                        (equal (ghostel--desired-size) full-size)
                        (string-match-p (format "INPUT %s %s" (car full-size) (cdr full-size)) (buffer-string))
                        (string-match-p (concat "L" (make-string (- (car full-size) 2) ?-) "R") (buffer-string))))))
              (should (eq process (get-buffer-process viewer))))))
      (when (buffer-live-p viewer)
        (let ((kill-buffer-query-functions nil)) (kill-buffer viewer)))
      (herdr-core-request "terminal.kill" (list :terminal (plist-get record :address))))))

(defun fleet-gui-check-viewer-refresh (viewer reference)
  "Check refresh entry points on a real VIEWER pinned to REFERENCE."
  (let* ((process (get-buffer-process viewer))
         (address (plist-get (agent-fleet-resolve reference) :address))
         (origin (selected-frame))
         (redraw (symbol-function 'ghostel-force-redraw))
         (redraws 0)
         (other (generate-new-buffer " *Fleet refresh origin*")))
    (unwind-protect
        (cl-letf (((symbol-function 'ghostel-force-redraw)
                   (lambda ()
                     (when (eq (current-buffer) viewer) (cl-incf redraws))
                     (funcall redraw))))
          ;; No window changes: reattach and reload must each refresh once.
          (dolist (action (list (lambda () (agent-fleet-attach reference))
                               (lambda () (load "agent-fleet-attach" nil t))))
            (setq redraws 0)
            (funcall action)
            (hc-live-until (lambda () (redisplay t) (> redraws 0)))
            (should (eq process (get-buffer-process viewer))))
          ;; First display and same-size reveal in an unselected split.
          (switch-to-buffer other)
          (let ((selected (selected-window)) (window (split-window-right)))
            (unwind-protect
                (dotimes (_ 2)
                  (set-window-buffer window other)
                  (redisplay t)
                  (sit-for 0.1)
                  (setq redraws 0)
                  (set-window-buffer window viewer)
                  (hc-live-until (lambda () (redisplay t) (> redraws 0)))
                  (should (eq (selected-window) selected))
                  (should (eq (window-buffer selected) other)))
              (delete-window window)))
          (switch-to-buffer viewer)
          (hc-live-until
           (lambda ()
             (redisplay t)
             (let ((size (with-current-buffer viewer (ghostel--desired-size)))
                   (record (herdr-core-request "terminal.get" (list :terminal address))))
               (and (= (car size) (plist-get record :cols))
                    (= (cdr size) (plist-get record :rows))))))
          (let ((before (herdr-core-request "terminal.get" (list :terminal address))))
            (agent-fleet-show-output reference)
            (should (frame-parameter nil 'agent-fleet-auxiliary-frame))
            (redisplay t)
            (sit-for 0.2)
            (setq redraws 0)
            (agent-fleet-display-close-auxiliary-frame (selected-frame))
            ;; Focus changes arrive on the GUI input queue.  Waiting only for
            ;; subprocess output can leave the frame switch unprocessed.
            (let ((deadline (+ (float-time) 5)))
              (while (and (not (and (eq (frame-focus-state origin) t) (> redraws 0)))
                          (< (float-time) deadline))
                (let ((event (read-event nil nil 0.05)))
                  (when (eq (car-safe event) 'switch-frame) (handle-switch-frame event))))
              (should (eq (frame-focus-state origin) t))
              (should (> redraws 0)))
            (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
              (should (equal (plist-get before :cols) (plist-get after :cols)))
              (should (equal (plist-get before :rows) (plist-get after :rows)))))
          (should (eq (window-buffer) viewer))
          (should (eq process (get-buffer-process viewer))))
      (kill-buffer other))))

(defun fleet-gui-check-launch-before-event ()
  "Attach a real newly launched terminal before its creation is cached."
  (let* ((record (herdr-core-request "terminal.run"
                                    '(:argv ["sh" "-c" "printf 'launch-ready\n'; sleep 30"]
                                      :no_parent t :labels (:fleet.role "agent"))))
         (reference (agent-fleet-reference record)) viewer)
    (unwind-protect
        (let ((herdr-core--terminals (make-hash-table :test 'equal)))
          (agent-fleet-attach reference)
          (setq viewer (current-buffer))
          (should (equal agent-fleet-target reference))
          (should (process-live-p (get-buffer-process viewer)))
          (hc-live-until (lambda () (redisplay t) (string-match-p "launch-ready" (buffer-string))))
          (agent-fleet-attach reference)
          (should (eq (current-buffer) viewer)))
      (when (buffer-live-p viewer)
        (let ((kill-buffer-query-functions nil)) (kill-buffer viewer)))
      (herdr-core-request "terminal.kill" (list :terminal (plist-get record :address))))))

(defun fleet-gui-smoke-run ()
  "Exercise real frames, Ghostel attachment, PTY size and detach."
  (let ((result-file (or (getenv "FLEET_GUI_RESULT") "/tmp/fleet-gui-result"))
        (code 0) (report "") viewers)
    (condition-case err
        (hc-live-isolated
          (unless (display-graphic-p) (error "Graphical Emacs is required"))
          (unless (agent-fleet-attach--ghostel-ready-p) (error "Ghostel is unavailable"))
          (setq evil-want-keybinding nil)
          (when (require 'evil nil t)
            (evil-set-initial-state 'special-mode 'motion)
            (evil-mode 1)
            (setq report (concat report "Evil enabled for real GUI command bindings.\n")))
          (global-set-key (kbd "C-c a") agent-fleet-command-map)
          (global-set-key (kbd "s-d") #'agent-fleet)
          (let ((agent-fleet--last-command nil))
            (should
             (equal (minibuffer-with-setup-hook
                        (lambda ()
                          (setq unread-command-events
                                (append (listify-key-sequence "sh -c \"sleep 60\"\r")
                                        unread-command-events)))
                      (agent-fleet--read-command))
                    '("sh" "-c" "sleep 60"))))
          (setq report (concat report "Command minibuffer preserves typed spaces and quoted arguments.\n"))
          (agent-fleet)
          (should (= (count-lines (point-min) (point-max)) 1))
          (should (string-prefix-p "No Fleet agents" (buffer-string)))
          (agent-fleet-dashboard-quit)
          (setq report (concat report "Empty Dashboard keeps a single message beneath the column header.\n"))
          (let* ((origin (selected-frame))
                 (origin-buffer (get-buffer-create "*Smoke Origin*"))
                 (record (herdr-core-request
                          "terminal.run"
                          (list :argv ["sh" "-c" "printf 'ready\n'; seq 1 100; sleep 60"] :cwd root
                                :name "remote-dev-skill-20261105"
                                :no_parent t)))
                 (address (plist-get record :address)))
            (switch-to-buffer origin-buffer)
            (hc-live-until (lambda () (herdr-core-terminal address)))
            (agent-fleet)
            (execute-kbd-macro (kbd "h A"))
            (should (equal (tabulated-list-get-id) address))
            (let ((left (selected-window)) (right (split-window-right)))
              (unwind-protect
                  (progn
                    (set-window-buffer right origin-buffer)
                    (call-interactively (key-binding (kbd "I")))
                    (should (derived-mode-p 'agent-fleet-details-mode))
                    (select-window right)
                    (agent-fleet)
                    (should-not (assoc address tabulated-list-entries))
                    (agent-fleet-dashboard--refresh-all)
                    (select-window left)
                    (call-interactively (key-binding (kbd "q")))
                    (should agent-fleet-dashboard--all-local)
                    (should (equal (tabulated-list-get-id) address)))
                (select-window left)
                (delete-window right)))
            (setq report (concat report "Details returns to the external terminal after another window opens Dashboard.\n"))
            (execute-kbd-macro (kbd "h +"))
            (hc-live-until (lambda () (agent-fleet-managed-p (herdr-core-terminal address))))
            (call-interactively (key-binding (kbd "A")))
            (should (equal (tabulated-list-get-id) address))
            (setq report (concat report "All-local Dashboard adopted the selected terminal through h +.\n"))
            (should (equal "Type" (car (aref tabulated-list-format 1))))
            (should (equal "sh" (aref (cadar tabulated-list-entries) 1)))
            (let ((width (frame-width origin)))
              (unwind-protect
                  (progn
                    (set-frame-width origin 110)
                    (hc-live-until (lambda () (= (frame-width origin) 110)))
                    (let ((right (split-window-right)))
                      (set-window-buffer right origin-buffer)
                      (redisplay t)
                      (hc-live-until (lambda () (and (= (length tabulated-list-format) 3)
                                                     (= agent-fleet-dashboard--layout-width
                                                        (window-body-width)))))
                      (should (string-match-p "remote-dev-skill-20261105" (buffer-string)))
                      (goto-char (point-min))
                      (should (eq (key-binding (kbd "C-s")) #'agent-fleet-dashboard-search))
                      (minibuffer-with-setup-hook
                          (lambda ()
                            (should (equal (minibuffer-prompt) "Find agent: "))
                            (insert (format "[%s]" address))
                            (setq unread-command-events (list ?\t ?\r)))
                        (execute-kbd-macro (kbd "h C-s")))
                      (should (equal (tabulated-list-get-id) address))
                      (delete-window right))
                    (redisplay t)
                    (hc-live-until (lambda () (= (length tabulated-list-format) 4)))
                    (should (string-match-p "remote-dev-skill-20261105" (buffer-string)))
                    (should (equal (tabulated-list-get-id) address)))
                (set-frame-width origin width)
                (sit-for 0.2)))
            (setq report (concat report "Dashboard refits after a split and h C-s finds the row by its hidden ID.\n"))
            ;; The isolated fixture suppresses consumer hooks; restore the
            ;; production Dashboard subscription for this interaction.
            (let ((herdr-core-changed-hook '(agent-fleet-dashboard--refresh-all))
                  (minibuffer-setup-hook
                   (list (lambda ()
                           (delete-minibuffer-contents)
                           (insert "GUI renamed agent")
                           (setq unread-command-events (list ?\r))))))
              (call-interactively (key-binding (kbd "R")))
              (hc-live-until
               (lambda () (equal (agent-fleet-name (herdr-core-terminal address)) "GUI renamed agent"))))
            (should (equal (tabulated-list-get-id) address))
            (should (string-match-p "GUI renamed agent" (buffer-string)))
            (setq report (concat report "Dashboard R renames through the minibuffer and retains the selected terminal.\n"))
            (sit-for 0.2)
            (should (eq (selected-frame) origin))
            (agent-fleet)
            (should-error (agent-fleet-dashboard--visit (lambda () (error "expected failure"))))
            (should (derived-mode-p 'agent-fleet-mode))
            (agent-fleet-dashboard-focus address)
            (call-interactively (key-binding (kbd "a")))
            (should (eq (selected-frame) origin))
            (let* ((viewer (current-buffer)) (reference agent-fleet-target)
                   (process (get-buffer-process viewer)))
              (push viewer viewers)
              (should agent-fleet-attach-mode)
              (should (process-live-p process))
              (sit-for 0.4)
              (let ((inhibit-message t)) (ghostel-char-mode))
              (should (eq (key-binding (kbd "C-c a s")) #'agent-fleet-prompt))
              (should (eq (key-binding (kbd "C-c a i")) #'agent-fleet-interrupt))
              (should (eq (key-binding (kbd "C-c a P")) #'agent-fleet-prompt-dwim))
              (dolist (key '("C-c a a" "s-d"))
                (call-interactively (key-binding (kbd key)))
                (should (derived-mode-p 'agent-fleet-mode))
                (call-interactively (key-binding (kbd "q")))
                (should (eq (current-buffer) viewer)))
              (setq report (concat report "Terminal char mode preserves the common prefix and global Dashboard entry keys.\n"))
              ;; Attach's initial resize reaches Core asynchronously.  Do not
              ;; compare the launch-time headless size with a settled viewer.
              (hc-live-until
               (lambda ()
                 (redisplay t)
                 (let ((size (with-current-buffer viewer (ghostel--desired-size)))
                       (record (herdr-core-request "terminal.get" (list :terminal address))))
                   (and (= (car size) (plist-get record :cols))
                        (= (cdr size) (plist-get record :rows))))))
              (should (equal (buffer-name) "*agent:GUI renamed agent*"))
              (let ((herdr-core-changed-hook '(agent-fleet-attach--refresh-names))
                    (before (herdr-core-request "terminal.get" (list :terminal address)))
                    (minibuffer-setup-hook
                     (list (lambda ()
                             (delete-minibuffer-contents)
                             (insert "Attached renamed agent")
                             (setq unread-command-events (list ?\r))))))
                (call-interactively (key-binding (kbd "C-c a R")))
                (hc-live-until (lambda () (equal (buffer-name viewer) "*agent:Attached renamed agent*")))
                (should (eq (window-buffer) viewer))
                (should (eq (get-buffer-process viewer) process))
                (ghostel--set-title "Old program title")
                (should (string-match-p "Attached renamed agent"
                                       (format-mode-line mode-line-buffer-identification)))
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal (plist-get before :cols) (plist-get after :cols)))
                  (should (equal (plist-get before :rows) (plist-get after :rows)))))
              (setq report (concat report "Attached rename updates buffer and mode line despite program titles; preserves process and PTY size.\n"))
              (agent-fleet)
              (execute-kbd-macro (kbd "h a"))
              (should (eq (current-buffer) viewer))
              (setq report (concat report "Dashboard a and menu a attach; C-c a a still opens Dashboard.\n"))
              (agent-fleet-attach reference)
              (should (eq viewer (current-buffer)))
              (let ((redraws 0)
                    (redraw (symbol-function 'ghostel-force-redraw))
                    (before (herdr-core-request "terminal.get" (list :terminal address))))
                (cl-letf (((symbol-function 'ghostel-force-redraw)
                           (lambda ()
                             (when (eq (current-buffer) viewer) (cl-incf redraws))
                             (funcall redraw))))
                  (switch-to-buffer origin-buffer)
                  (sit-for 0.2)
                  (switch-to-buffer viewer)
                  (sit-for 0.3)
                  (should (> redraws 0)))
                (should (eq (window-buffer) viewer))
                (should (eq process (get-buffer-process viewer)))
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal (plist-get before :cols) (plist-get after :cols)))
                  (should (equal (plist-get before :rows) (plist-get after :rows)))))
              (setq report (concat report "Buffer arrival redraws the existing viewer without reconnecting or resizing its PTY.\n"))
              (fleet-gui-check-viewer-refresh viewer reference)
              (setq report (concat report "Reattach, reload, unselected reveal and auxiliary focus return refresh the existing viewer.\n"))
              ;; Read history in Ghostel's reading mode.  Char mode follows
              ;; the live cursor on subsequent native output, even after a
              ;; Lisp goto-char; that is not a user-owned reading position.
              (let ((inhibit-message t)) (ghostel-emacs-mode))
              (goto-char (point-min))
              (set-window-start nil (point-min) t)
              (sit-for 0.2)
              (let ((position (point)) (start (window-start)))
                (agent-fleet)
                (sit-for 0.2)
                (agent-fleet-dashboard-quit)
                (sit-for 0.2)
                (should (= position (point)))
                (should (= start (window-start))))
              (let ((inhibit-message t)) (ghostel-char-mode))
              ;; Same-window review must never change the underlying PTY size.
              (let* ((before (herdr-core-request "terminal.get" (list :terminal address)))
                     (frames (frame-list)) (window (selected-window)) size-events
                     (herdr-core-event-hook
                      (cons (lambda (event)
                              (when (and (equal (plist-get event :type) "size")
                                         (equal (plist-get event :terminal) address))
                                (push event size-events)))
                            herdr-core-event-hook)))
                (agent-fleet)
                (sit-for 0.2)
                (should (eq (selected-window) window))
                (should (equal frames (frame-list)))
                (call-interactively (key-binding (kbd "I")))
                (should (derived-mode-p 'agent-fleet-details-mode))
                ;; An event can redraw Dashboard while a nested review is open.
                (agent-fleet-dashboard-refresh)
                (call-interactively (key-binding (kbd "q")))
                (should (derived-mode-p 'agent-fleet-mode))
                (should (equal (tabulated-list-get-id) address))
                (agent-fleet-control-results)
                (should (eq (current-buffer) (get-buffer "*Fleet Control Results*")))
                (call-interactively (key-binding (kbd "q")))
                (should (derived-mode-p 'agent-fleet-mode))
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal (plist-get before :cols) (plist-get after :cols)))
                  (should (equal (plist-get before :rows) (plist-get after :rows))))
                (execute-kbd-macro (kbd "h s"))
                (should (derived-mode-p 'agent-fleet-prompt-mode))
                (should (equal agent-fleet-target reference))
                (should-not (frame-parameter nil 'agent-fleet-auxiliary-frame))
                (agent-fleet-dashboard-refresh)
                (call-interactively (key-binding (kbd "C-c C-k")))
                (should (derived-mode-p 'agent-fleet-mode))
                (should (equal (tabulated-list-get-id) address))
                (agent-fleet-dashboard--visit #'agent-fleet-start-form)
                (should (derived-mode-p 'agent-fleet-start-mode))
                (call-interactively (key-binding (kbd "C-c C-k")))
                (should (derived-mode-p 'agent-fleet-mode))
                (call-interactively (key-binding (kbd "q")))
                (sit-for 0.2)
                (should (eq (current-buffer) viewer))
                (should (process-live-p process))
                (should-not size-events)
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal (plist-get before :cols) (plist-get after :cols)))
                  (should (equal (plist-get before :rows) (plist-get after :rows)))))
              (setq report (concat report "Same-window Dashboard, nested return, viewer retention and unchanged PTY size passed.\n"))
              (let* ((agent-fleet-commands '("sh -c \"sleep 60\""))
                     (agent-fleet--last-command nil)
                     (form (agent-fleet-start-form))
                     (child (selected-frame)) new-address)
                (call-interactively (key-binding (kbd "C-c C-c")))
                (hc-live-until (lambda () (eq agent-fleet-operation-state 'started)))
                (should (eq (current-buffer) form))
                (setq new-address (plist-get agent-fleet-operation-result :address))
                (call-interactively (key-binding (kbd "C-c C-a")))
                (push (current-buffer) viewers)
                (should (eq (selected-frame) origin))
                (should-not (frame-live-p child))
                (should-not (eq (current-buffer) viewer))
                (should (process-live-p process))
                (agent-fleet-attach reference)
                (herdr-core-request "terminal.kill" (list :terminal new-address))
                (hc-live-until
                 (lambda () (equal "finished" (plist-get (herdr-core-terminal new-address) :state))))
                (agent-fleet-present-buffer form)
                (setq child (selected-frame))
                (should-error (agent-fleet--start-form-attach) :type 'user-error)
                (should (eq (selected-frame) child))
                (should (eq (current-buffer) form))
                (should (frame-live-p child))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (agent-fleet-view-quit))
              (setq report (concat report "Launch result stays visible; origin attach and failure retention passed.\n"))
              (let ((agent-fleet-commands '("sh -c \"sleep 60\""))
                    (agent-fleet--last-command nil)
                    (before (herdr-core-request "terminal.get" (list :terminal address))))
                (agent-fleet)
                (agent-fleet-dashboard-focus address)
                (let ((dashboard (current-buffer)) (prompts 0))
                  (select-frame-set-input-focus (selected-frame))
                  (sit-for 0.1)
                  (let ((minibuffer-setup-hook
                         (cons (lambda ()
                                 (cl-incf prompts)
                                 (setq unread-command-events (cons ?\r unread-command-events)))
                               minibuffer-setup-hook)))
                    (execute-kbd-macro (kbd "h N")))
                  (should (= prompts 2))
                  (hc-live-until (lambda () (and (not (eq (window-buffer) dashboard))
                                               (buffer-local-value 'agent-fleet-attach-mode (window-buffer)))))
                  (let* ((new-viewer (window-buffer))
                         (new-reference (buffer-local-value 'agent-fleet-target new-viewer))
                         (new-address (plist-get (agent-fleet-resolve new-reference) :address)))
                    (should (equal (directory-file-name (file-truename (plist-get (agent-fleet-resolve new-reference) :cwd)))
                                   (directory-file-name (file-truename root))))
                    (push new-viewer viewers)
                    (should (process-live-p process))
                    (agent-fleet)
                    (goto-char (point-min))
                    (agent-fleet-dashboard-next)
                    (let ((first (tabulated-list-get-id)))
                      (execute-kbd-macro (kbd "h n"))
                      (should transient--prefix)
                      (should (eq (oref transient--prefix command) 'agent-fleet-dashboard-help))
                      (should-not (equal (tabulated-list-get-id) first))
                      (should (equal (plist-get (oref transient--prefix scope) :target)
                                     (agent-fleet-reference (herdr-core-terminal (tabulated-list-get-id)))))
                      (execute-kbd-macro (kbd "p"))
                      (should (equal (tabulated-list-get-id) first))
                      (execute-kbd-macro (kbd "I"))
                      (should (derived-mode-p 'agent-fleet-details-mode))
                      (should (equal (plist-get (agent-fleet-resolve agent-fleet-target) :address) first))
                      (agent-fleet-view-quit)
                      (agent-fleet-dashboard-quit))
                    (setq report (concat report "Transient n/p navigates with the menu open and Details uses the explicitly selected identity.\n"))
                    (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                      (should (equal (plist-get before :cols) (plist-get after :cols)))
                      (should (equal (plist-get before :rows) (plist-get after :rows))))
                    (agent-fleet-attach reference)
                    (herdr-core-request "terminal.kill" (list :terminal new-address)))))
              (setq report (concat report "Dashboard launch uses two minibuffer prompts, inherits cwd and attaches without resizing the previous terminal.\n"))
              ;; Exercise the command bound by Projectile as well as M-x start.
              ;; Both must leave the code buffer for the acknowledged terminal.
              (let* ((repo (expand-file-name "project" root))
                     (subdir (expand-file-name "src" repo))
                     (code-buffer (generate-new-buffer " *Fleet launch source*"))
                     (agent-fleet--last-command "sh -c \"sleep 60\""))
                (make-directory subdir t)
                (should (= 0 (call-process "git" nil nil nil "-C" repo "init" "-q")))
                (unwind-protect
                    (dolist (command '(agent-fleet-start-for-project agent-fleet-start))
                      (switch-to-buffer code-buffer)
                      (setq default-directory (file-name-as-directory subdir))
                      (select-frame-set-input-focus origin)
                      (sit-for 0.1)
                      (let ((minibuffer-setup-hook
                             (cons (lambda () (setq unread-command-events (cons ?\r unread-command-events)))
                                   minibuffer-setup-hook)))
                        (call-interactively command))
                      (hc-live-until (lambda () (and (not (eq (window-buffer) code-buffer))
                                                   (buffer-local-value 'agent-fleet-attach-mode (window-buffer)))))
                      (set-buffer (window-buffer))
                      (let ((created (agent-fleet-resolve agent-fleet-target)))
                        (push (current-buffer) viewers)
                        (should (equal (directory-file-name (plist-get created :cwd))
                                       (file-truename (if (eq command 'agent-fleet-start-for-project) repo subdir))))
                        (should (process-live-p (get-buffer-process (current-buffer))))
                        (agent-fleet-attach reference)
                        (herdr-core-request "terminal.kill" (list :terminal (plist-get created :address)))))
                  (kill-buffer code-buffer)))
              (setq report (concat report "Project/Projectile and M-x launch commands automatically attach from code buffers using the correct directory.\n"))
              (let* ((record (cl-find-if (lambda (r) (equal (plist-get r :state) "finished"))
                                        (agent-fleet-agents t)))
                     (form (agent-fleet-prompt (agent-fleet-reference record) "Retained draft"))
                     (child (selected-frame)))
                (call-interactively (key-binding (kbd "C-c C-c")))
                (hc-live-until (lambda () (eq agent-fleet-operation-state 'rejected)))
                (should (eq (current-buffer) form))
                (should (eq (selected-frame) child))
                (should (equal (buffer-string) "Retained draft"))
                (should (string-match-p "finished"
                                        (overlay-get agent-fleet-prompt--status-overlay 'before-string)))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (call-interactively (key-binding (kbd "C-c C-k"))))
              (setq report (concat report "Prompt rejection retains draft, diagnostics, focus and attached viewer.\n"))
              (dolist (source '(attach dashboard))
                (agent-fleet-attach reference)
                (when (eq source 'dashboard) (agent-fleet))
                (let* ((before (herdr-core-request "terminal.get" (list :terminal address)))
                       (form (agent-fleet-prompt reference "fleet-gui-prompt"))
                       (prompt-frame (selected-frame)))
                  (select-frame-set-input-focus prompt-frame)
                  (sit-for 0.2)
                  (call-interactively (key-binding (kbd "C-c C-c")))
                  (hc-live-until
                   (lambda () (not (eq (buffer-local-value 'agent-fleet-operation-state form) 'sending))) 10)
                  (should (eq (buffer-local-value 'agent-fleet-operation-state form) 'sent))
                  (should-not (buffer-local-value 'agent-fleet-prompt--attach-error form))
                  (should (eq (selected-frame) origin))
                  (should (eq (window-buffer) viewer))
                  (when (eq source 'attach) (should-not (frame-live-p prompt-frame)))
                  (should (process-live-p process))
                  (with-current-buffer form
                    (should (equal (buffer-string) "fleet-gui-prompt")))
                  (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                    (should (equal (plist-get before :cols) (plist-get after :cols)))
                    (should (equal (plist-get before :rows) (plist-get after :rows))))
                  (kill-buffer form)
                  (set-buffer (window-buffer))))
              (setq report (concat report "Prompt acknowledgement attaches from Dashboard and auxiliary views, retaining text and PTY geometry.\n"))
              ;; DWIM from code must reuse the terminal beside it, not duplicate it.
              (let* ((code-buffer (generate-new-buffer " *Fleet DWIM source*"))
                     (left (selected-window)) (right (split-window-right))
                     form before geometry position start size-events
                     (herdr-core-event-hook
                      (cons (lambda (event)
                              (when (and (equal (plist-get event :type) "size")
                                         (equal (plist-get event :terminal) address))
                                (push event size-events)))
                            herdr-core-event-hook)))
                (unwind-protect
                    (progn
                      (switch-to-buffer code-buffer)
                      (dotimes (n 100) (insert (format "source line %d\n" n)))
                      (goto-char (point-min))
                      (forward-line 40)
                      (setq position (point))
                      (set-window-start left position)
                      (set-window-buffer right viewer)
                      (message nil)
                      (redisplay t)
                      (hc-live-until
                       (lambda ()
                         (redisplay t)
                         (let ((record (herdr-core-request "terminal.get" (list :terminal address)))
                               (size (with-current-buffer viewer (ghostel--desired-size))))
                           (and size (= (plist-get record :cols) (car size))
                                (= (plist-get record :rows) (cdr size))))))
                      (setq before (herdr-core-request "terminal.get" (list :terminal address))
                            geometry (mapcar #'window-edges (list left right))
                            start (window-start left) size-events nil)
                      (cl-letf (((symbol-function 'agent-fleet-read-agent) (lambda () reference)))
                        (call-interactively (key-binding (kbd "C-c a P"))))
                      (setq form (current-buffer))
                      (should (derived-mode-p 'agent-fleet-prompt-mode))
                      (insert "split-window-dwim")
                      (select-frame-set-input-focus origin)
                      (sit-for 0.1)
                      (call-interactively (key-binding (kbd "C-c C-c")))
                      (hc-live-until (lambda () (eq (selected-window) right)))
                      (set-buffer (window-buffer))
                      (should (eq (window-buffer left) code-buffer))
                      (should (eq (window-buffer right) viewer))
                      (should (= (window-point left) position))
                      (should (= (window-start left) start))
                      (should (equal geometry (mapcar #'window-edges (list left right))))
                      (should (process-live-p process))
                      (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                        (should (= (plist-get before :cols) (plist-get after :cols)))
                        (should (= (plist-get before :rows) (plist-get after :rows))))
                      (should-not size-events))
                  (select-window right)
                  (delete-other-windows)
                  (kill-buffer code-buffer)
                  (when (buffer-live-p form) (kill-buffer form))))
              (setq report (concat report "Split-window DWIM restores code, point and scroll; reuses the right viewer without PTY resize events.\n"))
              (agent-fleet-cleanup)
              (let ((child (selected-frame))
                    (item (get-text-property (point) 'fleet-cleanup-item)))
                (should item)
                (should (frame-parameter nil 'agent-fleet-auxiliary-frame))
                (call-interactively (key-binding (kbd "SPC")))
                (should-not (plist-get item :selected))
                (call-interactively (key-binding (kbd "SPC")))
                (should (plist-get item :selected))
                (call-interactively (key-binding (kbd "C-c C-c")))
                (should (eq (plist-get item :status) 'removed))
                (should (eq (selected-frame) child))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (call-interactively (key-binding (kbd "q"))))
              (setq report (concat report "Cleanup initial selection and results preserve the attached viewer.\n"))
              ;; Settle the return from the preceding child before measuring a
              ;; new review.  Its pending resize must not enter this baseline.
              (message nil)
              (redisplay t)
              (hc-live-until
               (lambda ()
                 (redisplay t)
                 (let ((record (herdr-core-request "terminal.get" (list :terminal address)))
                       (size (with-current-buffer viewer (ghostel--desired-size))))
                   (and size (= (plist-get record :cols) (car size))
                        (= (plist-get record :rows) (cdr size))))))
              (let ((before (herdr-core-request "terminal.get" (list :terminal address))))
                (agent-fleet)
                (execute-kbd-macro (kbd "h I"))
                (should (derived-mode-p 'agent-fleet-details-mode))
                (should (equal agent-fleet-target reference))
                (should (string-match-p "Type +sh" (buffer-string)))
                (should (string-match-p "Type source +Launch command" (buffer-string)))
                (let ((child (selected-frame)) (details (current-buffer)))
                  (call-interactively (key-binding (kbd "g")))
                  (should (eq (current-buffer) details))
                  (should (eq (selected-frame) child))
                  (call-interactively (key-binding (kbd "p")))
                  (should (derived-mode-p 'agent-fleet-prompt-mode))
                  (should (equal agent-fleet-target reference))
                  (call-interactively (key-binding (kbd "C-c C-k")))
                  (should (derived-mode-p 'agent-fleet-details-mode))
                  (agent-fleet-view-quit)
                  (agent-fleet-dashboard-quit)
                  (should (eq (current-buffer) viewer))
                  (agent-fleet-details reference)
                  (should (eq (current-buffer) details))
                  (call-interactively (key-binding (kbd "o")))
                  (should (derived-mode-p 'agent-fleet-output-mode))
                  (call-interactively (key-binding (kbd "q")))
                  (agent-fleet-details reference)
                  (setq child (selected-frame))
                  (call-interactively (key-binding (kbd "RET")))
                  (should-not (frame-live-p child))
                  (should (eq (current-buffer) viewer)))
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal (plist-get before :cols) (plist-get after :cols)))
                  (should (equal (plist-get before :rows) (plist-get after :rows)))))
              (setq report (concat report "Details refresh, actions and reuse preserve target, origin and PTY geometry.\n"))
              (let* ((before (herdr-core-request "terminal.get" (list :terminal address)))
                     (cols (plist-get before :cols)) (rows (plist-get before :rows)))
                (agent-fleet-show-output reference)
                (sit-for 0.2)
                (should (frame-parameter nil 'agent-fleet-auxiliary-frame))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (let ((child (selected-frame)) (buffer (current-buffer)))
                  (call-interactively (key-binding (kbd "g")))
                  (should (eq (selected-frame) child))
                  (should (eq (current-buffer) buffer))
                  (should (string-match-p "ready" (buffer-string))))
                (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                  (should (equal cols (plist-get after :cols)))
                  (should (equal rows (plist-get after :rows))))
                ;; Opening Dashboard from an auxiliary view must retain the
                ;; real origin window, not adopt the auxiliary window.
                (let ((auxiliary (selected-frame)))
                  (agent-fleet)
                  (should (eq (selected-frame) origin))
                  (should-not (frame-live-p auxiliary))
                  (agent-fleet-dashboard-quit))
                (agent-fleet-view-quit)
                (should (eq (current-buffer) viewer))
                (set-frame-size origin (+ (frame-width origin) 4) (+ (frame-height origin) 2))
                (sit-for 0.3)
                (hc-live-until
                 (lambda ()
                   (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                     (not (and (equal cols (plist-get after :cols))
                               (equal rows (plist-get after :rows))))))))
              (when (require 'magit nil t)
                (let ((default-directory root)) (call-process "git" nil nil nil "init" "-q"))
                (agent-fleet-magit-status reference)
                (should (frame-parameter nil 'agent-fleet-auxiliary-frame))
                (should (eq (window-buffer (frame-selected-window origin)) viewer))
                (agent-fleet-display-close-auxiliary-frame (selected-frame))
                (setq report (concat report "Magit auxiliary review passed.\n"))
                (select-frame-set-input-focus origin)
                (switch-to-buffer viewer)
                (dolist (direction '(below right))
                  (let* ((window (selected-window))
                         (width (window-body-width window))
                         (height (window-body-height window))
                         (redraw (symbol-function 'ghostel-force-redraw))
                         (redraws 0)
                         (magit-display-buffer-function
                          (lambda (buffer)
                            (display-buffer buffer
                                            `((display-buffer-in-direction)
                                              (direction . ,direction)
                                              (window . ,window))))))
                    (magit-status root)
                    (should (derived-mode-p 'magit-mode))
                    (should (= (length (window-list origin 'nomini)) 2))
                    (redisplay t)
                    (sit-for 0.3)
                    (let ((magit-window (selected-window)))
                      (cl-letf (((symbol-function 'ghostel-force-redraw)
                                 (lambda ()
                                   (when (eq (current-buffer) viewer) (cl-incf redraws))
                                   (funcall redraw))))
                        (if (eq direction 'below)
                            (magit-mode-bury-buffer)
                          ;; Removing an unselected split changes only size.
                          (select-window window)
                          (sit-for 0.2)
                          (setq redraws 0)
                          (delete-window magit-window))
                        (ert-info ((format "Magit %s return: size=%S timer=%S"
                                           direction
                                           (window-parameter window 'agent-fleet-attach-size)
                                           (buffer-local-value 'agent-fleet-attach--redraw-timer viewer)))
                          (hc-live-until (lambda () (redisplay t) (> redraws 0))))))
                    (should (= (length (window-list origin 'nomini)) 1))
                    (should (eq (window-buffer window) viewer))
                    (should (= width (window-body-width window)))
                    (should (= height (window-body-height window)))
                    (should (eq process (get-buffer-process viewer)))
                    (hc-live-until
                     (lambda ()
                       (let ((size (with-current-buffer viewer (ghostel--desired-size)))
                             (record (herdr-core-request "terminal.get" (list :terminal address))))
                         (and (= (car size) (plist-get record :cols))
                              (= (cdr size) (plist-get record :rows))))))))
                (setq report (concat report "Closing real Magit splits refits and redraws the full terminal, including size-only changes.\n")))
              ;; A new Emacs frame initially displays the current buffer.
              ;; Do not briefly put the interactive viewer in a smaller frame.
              (switch-to-buffer origin-buffer)
              (let* ((observer-frame (make-frame '((width . 55) (height . 16))))
                     before observer)
                (unwind-protect
                    (progn
                      (set-window-buffer (frame-selected-window observer-frame) origin-buffer)
                      (select-frame-set-input-focus origin)
                      (switch-to-buffer viewer)
                      ;; Earlier prompts can leave a multi-line echo area.
                      ;; Settle it before comparing the terminal viewport.
                      (message nil)
                      (redisplay t)
                      (sit-for 0.3)
                      ;; Parent resizing earlier in this test reaches Core
                      ;; asynchronously; sample only once its PTY has caught up.
                      (hc-live-until
                       (lambda ()
                         (redisplay t)
                         (let ((size (with-current-buffer viewer (ghostel--desired-size)))
                               (record (herdr-core-request "terminal.get" (list :terminal address))))
                           (and (equal (car size) (plist-get record :cols))
                                (equal (cdr size) (plist-get record :rows))))))
                      (setq before (herdr-core-request "terminal.get" (list :terminal address)))
                      (select-frame-set-input-focus observer-frame)
                      (agent-fleet-observe reference)
                      (setq observer (current-buffer))
                      (push observer viewers)
                      (should agent-fleet-observe-p)
                      (should-not (eq observer viewer))
                      (sit-for 0.4)
                      (agent-fleet-observe reference)
                      (should (eq observer (current-buffer)))
                      (ghostel-send-string "OBSERVER-MUST-NOT-TYPE\n")
                      (set-frame-size observer-frame 65 19)
                      (sit-for 0.4)
                      (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                        (should (equal (plist-get before :cols) (plist-get after :cols)))
                        (should (equal (plist-get before :rows) (plist-get after :rows))))
                      (should-not (string-match-p "OBSERVER-MUST-NOT-TYPE"
                                                  (plist-get (herdr-core-request "terminal.read"
                                                                                (list :terminal address)) :text)))
                      ;; q must win even over Ghostel's full character input map.
                      (let ((inhibit-message t)) (ghostel-char-mode))
                      (should (eq (key-binding (kbd "q")) #'agent-fleet-observe-quit))
                      (call-interactively (key-binding (kbd "q")))
                      (should-not (buffer-live-p observer))
                      (should (eq (current-buffer) origin-buffer))
                      ;; Opening from Dashboard retains its selected row and return path.
                      (agent-fleet)
                      (agent-fleet-dashboard-focus address)
                      ;; A keyboard macro otherwise follows the last native
                      ;; input frame, which can still be the interactive viewer.
                      (execute-kbd-macro (vconcat (vector (list 'switch-frame (selected-frame)))
                                                 (kbd "h v")))
                      (setq observer (current-buffer))
                      (should agent-fleet-observe-p)
                      (call-interactively (key-binding (kbd "q")))
                      (should-not (buffer-live-p observer))
                      (should (derived-mode-p 'agent-fleet-mode))
                      (should (equal (tabulated-list-get-id) address))
                      (agent-fleet-dashboard-quit)
                      (should (eq (current-buffer) origin-buffer))
                      (should (process-live-p process))
                      (with-current-buffer viewer
                        (should-not (eq (key-binding (kbd "q")) #'agent-fleet-observe-quit)))
                      (let ((after (herdr-core-request "terminal.get" (list :terminal address))))
                        (should (equal (plist-get after :state) "live"))
                        (should (equal (plist-get before :cols) (plist-get after :cols)))
                        (should (equal (plist-get before :rows) (plist-get after :rows)))))
                  (when (buffer-live-p observer)
                    (let ((kill-buffer-query-functions nil)) (kill-buffer observer)))
                  (delete-frame observer-frame)
                  (select-frame-set-input-focus origin)))
              (setq report (concat report "Observer reuse, input/resize isolation and q detach/return preserve the agent and interactive viewer.\n"))
              (let ((kill-buffer-query-functions nil)) (kill-buffer viewer))
              (sit-for 0.2)
              (should (equal "live" (plist-get (herdr-core-request
                                              "terminal.get" (list :terminal address)) :state)))
              (should (buffer-live-p origin-buffer)))
            (herdr-core-request "terminal.kill" (list :terminal address))
            (setq report (concat report "Centering, focus, repeated open, failure retention, attach, output geometry, parent resize and detach passed.\n"))
            (fleet-gui-check-launch-before-event)
            (setq report (concat report "New terminal attaches before its creation event is cached and reuses the same viewer.\n"))
            (if (and (executable-find "python3") (require 'magit nil t))
                (progn
                  (fleet-gui-check-quiet-resize root)
                  (setq report (concat report "Quiet resize redraws full-width borders and input after Magit quit, deletion and window restoration.\n")))
              (setq report (concat report "SKIPPED quiet resize: Python 3 and Magit required.\n")))))
      ((error quit)
       (setq code 1 report
             (concat report (format "FAILED: %S\nBuffer: %S Window: %S Focus: %S\n"
                                     err (buffer-name) (buffer-name (window-buffer))
                                     (frame-focus-state))
                     (when (get-buffer "*Messages*")
                       (with-current-buffer "*Messages*" (buffer-string)))))))
    (dolist (buffer viewers)
      (when (buffer-live-p buffer)
        (let ((kill-buffer-query-functions nil)) (kill-buffer buffer))))
    (with-temp-file result-file (insert report))
    (kill-emacs code)))
(run-at-time 0.5 nil #'fleet-gui-smoke-run)
