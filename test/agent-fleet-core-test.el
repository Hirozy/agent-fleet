(ert-deftest fleet-output-refresh-pins-identity-and-preserves-snapshot-on-error ()
  (fleet-test-model (list (fleet-test-agent "t1"))
    (with-temp-buffer
      (agent-fleet-output-mode)
      (setq agent-fleet-target (agent-fleet-reference (herdr-core-terminal "t1")))
      (let ((text "first snapshot") fail calls)
        (cl-letf (((symbol-function 'herdr-core-request)
                   (lambda (method &optional _params _timeout)
                     (push method calls)
                     (pcase method
                       ("terminal.get" (herdr-core-terminal "t1"))
                       ("terminal.read" (if fail (error "Read failed")
                                          (list :text text :how "history" :complete t)))
                       (_ (error "Unexpected operation: %s" method))))))
          (call-interactively (key-binding (kbd "g")))
          (should (string-match-p text (buffer-string)))
          (goto-char 5)
          (setq text "updated snapshot")
