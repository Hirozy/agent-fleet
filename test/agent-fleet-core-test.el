    (call-interactively (key-binding (kbd "n")))
    (let ((second (cadr agent-fleet-cleanup--items)))
      (call-interactively (key-binding (kbd "SPC")))
      (should (eq (get-text-property (point) 'fleet-cleanup-item) second))
      (should (string-match-p "1 of 2 records selected" (buffer-string)))
      (call-interactively (key-binding (kbd "n")))
      (should (eq (get-text-property (point) 'fleet-cleanup-item) second))
      (agent-fleet-cleanup-execute)
      (should (eq (get-text-property (point) 'fleet-cleanup-item) second))
      (should (string-match-p "1 removed.*1 skipped" (buffer-string)))
      (should-not (string-match-p "0 not attempted" (buffer-string)))
      (should (string-match-p "Excluded in review" (buffer-string)))
      ;; Navigation also works from the diagnostic beneath a record.
      (forward-line 1)
      (call-interactively (key-binding (kbd "p")))
      (should (eq (get-text-property (point) 'fleet-cleanup-item)
                  (car agent-fleet-cleanup--items)))
      (should (equal (mapcar (lambda (r) (plist-get r :address)) inventory) '("t2")))
