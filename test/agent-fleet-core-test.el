(ert-deftest fleet-control-feedback-keeps-observed-outcomes-distinct ()
  (let ((record (fleet-test-agent "t1")))
    (dolist (case '((interrupt (:key "esc" :outcome "stopped") "work stopped")
                    (interrupt (:key "esc" :outcome "still_working") "still working")
                    (interrupt (:key "ctrl+c" :outcome "unknown") "effect unknown")
                    (interrupt (:key "esc" :outcome "exited") "program exited")
                    (wait (:terminal "t1" :ended :false :reason "timeout" :status "working")
                          "timed out (working)")
                    (wait (:terminal "t1" :ended t :reason "status" :status "blocked")
                          "status reported (blocked)")
                    (wait (:terminal "t1" :ended :false :reason "not_started") "work did not start")
                    (wait (:terminal "t1" :ended t :reason "exit") "program exited")
                    (wait (:terminal "t1" :ended :false :reason "message") "message received")))
      (should (string-match-p (regexp-quote (nth 2 case))
                              (agent-fleet--control-summary (car case) record (cadr case)))))
    (should (equal "End requested; Core still reports live"
                   (agent-fleet--control-summary 'end record record)))
    (should-not (agent-fleet--control-summary 'end record (fleet-test-agent "t2" "finished")))
    (should-not (agent-fleet--control-summary 'end record '(:address "t1" :created_ms 2 :state "finished")))
    (should-not (agent-fleet--control-summary 'interrupt record nil))))

(ert-deftest fleet-end-feedback-is-concise-and-retains-identity-and-response ()
  (fleet-test-model (list (fleet-test-agent "t1"))
    (let ((agent-fleet--control-results nil)
          (response (append (fleet-test-agent "t1" "finished") '(:exit_code 129 :reason "killed")))
          methods confirmation feedback)
      (cl-letf (((symbol-function 'herdr-core-request)
                 (lambda (method &rest _)
                   (if (equal method "terminal.list") (list :terminals (herdr-core-terminals))
                     (herdr-core-terminal "t1"))))
                ((symbol-function 'yes-or-no-p) (lambda (prompt) (setq confirmation prompt) t))
                ((symbol-function 'message) (lambda (format &rest args) (setq feedback (apply #'format format args))))
                ((symbol-function 'herdr-core-request-async)
                 (lambda (method params callback &rest _)
                   (push method methods)
                   (should (equal params '(:terminal "t1")))
                   (funcall callback response nil))))
        (agent-fleet-kill "t1")
        (should (equal methods '("terminal.kill")))
        (should (string-match-p "dependent descendants" confirmation))
        (should (equal feedback "t1 [t1] — Ended (exit code 129)"))
        (should (equal (plist-get (car agent-fleet--control-results) :response) response))
        (should (equal (plist-get (car agent-fleet--control-results) :target)
                       (agent-fleet-reference (herdr-core-terminal "t1"))))))))

(ert-deftest fleet-control-rejection-and-uncertainty-retain-diagnostics-without-retry ()
  (fleet-test-model (list (fleet-test-agent "t1"))
    (dolist (case '((nil (herdr-core-request-error :error (:code -32000 :message "unavailable")) "rejected: unavailable")
                    (nil (herdr-core-uncertain :reason timeout) "outcome unknown: timeout")
                    ((:unexpected t) nil "outcome unknown: invalid-control-response")))
      (let ((agent-fleet--control-results nil) (calls 0) feedback)
        (cl-letf (((symbol-function 'message) (lambda (format &rest args) (setq feedback (apply #'format format args))))
                  ((symbol-function 'herdr-core-request-async)
                   (lambda (_method _params callback &rest _)
                     (cl-incf calls) (funcall callback (car case) (cadr case)))))
          (agent-fleet--control-request 'interrupt (herdr-core-terminal "t1"))
          (should (= calls 1))
          (should (string-match-p (nth 2 case) feedback))
          (should (equal (plist-get (car agent-fleet--control-results) :response) (car case)))
          (when (cadr case)
            (should (equal (plist-get (car agent-fleet--control-results) :error) (cadr case)))))))))

