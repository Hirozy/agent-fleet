(ert-deftest fleet-cleanup-focus-follows-record-through-selection-and-results ()
  (fleet-test-cleanup (list (fleet-test-agent "t1" "finished")
                            (fleet-test-agent "t2" "finished"))
    (agent-fleet-cleanup--render)
    (should (eq (get-text-property (point) 'fleet-cleanup-item)
                (car agent-fleet-cleanup--items)))
