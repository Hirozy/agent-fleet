(defmacro fleet-test-model (records &rest body)
  "Install RECORDS and run BODY without opening a real connection."
  (declare (indent 1))
  `(hc-test-model
     (let ((herdr-core--state 'connected))
       (herdr-core--snapshot (list :seq 1 :terminals ,records))
       (cl-letf (((symbol-function 'herdr-core-connect) #'ignore))
         ,@body))))

(defun fleet-test-agent (address &optional state)
  "Return agent ADDRESS with STATE."
  (hc-test-record address state '(:fleet.role "agent")))

(ert-deftest fleet-unreported-agent-is-a-member ()
  (fleet-test-model (list (fleet-test-agent "t1") (hc-test-record "t2"))
    (should (= (length (agent-fleet-agents)) 1))
    (should (equal (agent-fleet-status (car (agent-fleet-agents))) "unreported"))))

(ert-deftest fleet-type-prefers-reported-app-without-inventing-status ()
  (dolist (case '(((:argv ["/opt/bin/claude"]) . "claude")
                  ((:argv ("codex" "--model" "x")) . "codex")
                  ((:argv ["/remote/bin/pi"] :address "remote/t1") . "pi")
                  ((:argv ["sh" "-c" "claude"]) . "sh")
                  ((:argv ["node"] :status (:app "pi" :state "idle")) . "pi")
                  ((:argv ["codex"] :status (:app "  ")) . "codex")
                  ((:argv []) . "—")
                  ((:name "claude" :template "reviewer") . "—")))
    (should (equal (agent-fleet-type (car case)) (cdr case))))
  (should (equal (agent-fleet-status '(:argv ["claude"])) "unreported")))

(ert-deftest fleet-dashboard-type-updates-with-reports-and-keeps-column-preferences ()
  (fleet-test-model (list (append (fleet-test-agent "t1") '(:argv ["claude"])))
    (let ((buffer (get-buffer-create "*Agent Fleet*")))
      (unwind-protect
          (with-current-buffer buffer
            (agent-fleet-mode)
            (agent-fleet-dashboard-refresh)
            (should (equal (aref (cadar tabulated-list-entries) 1) "claude"))
            (should (= (length (cadar tabulated-list-entries)) 4))
            (should (equal (mapcar #'car (append tabulated-list-format nil)) '("Agent" "Type" "Status" "ID")))
            (should (equal (aref (cadar tabulated-list-entries) 2) "unreported"))
            (setf (cadr (aref tabulated-list-format 1)) 18)
            (herdr-core--event '(:seq 2 :type "status" :terminal "t1"
                                :data (:status (:app "custom-agent" :state "idle"))))
            (agent-fleet-dashboard-refresh)
            (should (= (cadr (aref tabulated-list-format 1)) 18))
            (should (equal (aref (cadar tabulated-list-entries) 1) "custom-agent")))
        (kill-buffer buffer)))))

(ert-deftest fleet-dashboard-layout-refits-names-and-keeps-row-identity ()
  (let ((first (fleet-test-agent "t1"))
        (helper (hc-test-record "t2"))
        (name "remote-dev-skill-20261105")
        (width 80))
    (setf (plist-get first :name) name
          (plist-get first :status) '(:app "claude-code" :state "idle")
          (plist-get helper :parent) "t1"
          (plist-get helper :status) '(:state "blocked"))
    (fleet-test-model (list first helper)
      (save-window-excursion
        (let ((buffer (get-buffer-create "*Agent Fleet*")))
          (unwind-protect
              (cl-letf (((symbol-function 'agent-fleet-project-for-agent) (lambda (_) nil))
                        ((symbol-function 'agent-fleet-dashboard--available-width) (lambda () width)))
                (switch-to-buffer buffer)
                (agent-fleet-mode)
                (agent-fleet-dashboard-refresh)
                (should (string-match-p (regexp-quote name) (buffer-string)))
                (should (string-match-p "claude-code" (buffer-string)))
                (should (string-match-p "No Project · 2 agents" (buffer-string)))
                (should (string-match-p "Helper of t1" (buffer-string)))
                (should-not (string-match-p "Directory:" (buffer-string)))
                (agent-fleet-dashboard--goto "t1")
                (setq width 60)
                (agent-fleet-dashboard--resize (selected-window))
                (should (equal (tabulated-list-get-id) "t1"))
                (should (equal (aref (tabulated-list-get-entry) 0) name))
                (should (or (string-match-p "…" (buffer-substring (line-beginning-position) (line-end-position)))
                            (cl-loop for pos from (line-beginning-position) below (line-end-position)
                                     thereis (equal (get-text-property pos 'display) "…"))))
                (should (equal (get-text-property (1+ (line-beginning-position)) 'help-echo)
                               (concat "Agent: " name)))
                (should (string-match-p "claude-code" (buffer-string)))
                (should (<= (+ tabulated-list-padding 3
                               (apply #'+ (mapcar #'cadr (append tabulated-list-format nil)))) width))
                (setq width 110)
                (agent-fleet-dashboard--resize (selected-window))
                (should (equal (tabulated-list-get-id) "t1"))
                (should (string-match-p (regexp-quote name) (buffer-string)))
                (setq agent-fleet-dashboard--attention t)
                (agent-fleet-dashboard-refresh)
                (should (string-match-p "No Project · 1 agent" (buffer-string)))
                (should (equal (tabulated-list-get-id) "t2"))
                (forward-line 1)
                (should (equal (plist-get (agent-fleet-resolve (agent-fleet-dashboard--target)) :address) "t2"))
                (with-temp-buffer
                  (agent-fleet-details-mode)
                  (agent-fleet-details--render helper)
                  (should (string-match-p "Role +Helper" (buffer-string)))
                  (should (string-match-p "Parent +t1" (buffer-string)))))
            (kill-buffer buffer)))))))

