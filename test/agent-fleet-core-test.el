(ert-deftest fleet-cleanup-groups-preserve-targets-and-execution-order ()
  (fleet-test-cleanup (list (fleet-test-agent "t1" "finished")
                            (fleet-test-agent "t2" "finished")
                            (fleet-test-agent "t3" "finished"))
    (let ((items (copy-sequence agent-fleet-cleanup--items)))
      (cl-loop for item in items for cwd in '("/one" "/two" "/one")
               do (setf (plist-get (plist-get item :record) :cwd) cwd))
      (agent-fleet-cleanup--render)
      (should (equal items agent-fleet-cleanup--items))
      (should (equal agent-fleet-cleanup--display-items
                     (list (nth 0 items) (nth 2 items) (nth 1 items))))
      (agent-fleet-cleanup-next)
      (should (eq (get-text-property (point) 'fleet-cleanup-item) (nth 2 items)))
      (agent-fleet-cleanup-toggle)
      (should-not (plist-get (nth 2 items) :selected))
      (agent-fleet-cleanup-next)
      (should (eq (get-text-property (point) 'fleet-cleanup-item) (nth 1 items)))
      (let ((request (symbol-function 'herdr-core-request)) removed)
        (cl-letf (((symbol-function 'herdr-core-request)
                   (lambda (method &optional params timeout)
                     (when (equal method "terminal.rm")
                       (push (plist-get params :terminal) removed))
                     (funcall request method params timeout))))
          (agent-fleet-cleanup-execute))
        (should (equal (reverse removed) '("t1" "t2"))))
      (should (eq (get-text-property (point) 'fleet-cleanup-item) (nth 1 items)))
      (should-not (string-match-p "\\[x\\]\\|\\[ \\]" (buffer-string)))
      (goto-char (point-min))
      (should (= 1 (how-many "^/one")))
      (should (= 1 (how-many "^/two"))))))

