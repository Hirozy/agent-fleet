;;; agent-fleet-project-test.el --- Project identity and presentation -*- lexical-binding: t; -*-
(require 'agent-fleet-launch-test)
(require 'agent-fleet-details)

(ert-deftest fleet-project-submodule-worktrees-share-one-dashboard-group ()
  (fleet-test-git
    (let* ((super (expand-file-name "super" dir))
           (module (expand-file-name "lib/module" super))
           (other (expand-file-name "other-worker" dir))
           (nested (expand-file-name "src" other))
           (first (fleet-test-agent "t1")) (second (fleet-test-agent "t2"))
           (third (fleet-test-agent "t3")))
      (make-directory super)
      (fleet-test-git-command super "init" "-q")
      (fleet-test-git-command super "-c" "protocol.file.allow=always"
                              "submodule" "add" "--" repo "lib/module")
      (fleet-test-git-command module "worktree" "add" "-b" "worker" wt)
      (fleet-test-git-command module "worktree" "add" "-b" "other" other)
      (make-directory nested)
      (setf (plist-get first :cwd) module
            (plist-get second :cwd) wt
            (plist-get third :cwd) nested)
      (dolist (agent-fleet-project-backend '(project projectile))
        (let ((agent-fleet-project--cache (make-hash-table :test 'equal)))
          (cl-letf (((symbol-function 'agent-fleet-project--backend-root-for-cwd)
                     (lambda (_) (ert-fail "Git worktrees must not need a project backend"))))
            (dolist (record (list first second third))
              (should (equal (agent-fleet-project-for-agent record) (file-truename module))))
            (should (equal (agent-fleet-project-checkout-for-cwd nested) (file-truename other)))
            (fleet-test-model (list first second third)
              (let ((buffer (get-buffer-create "*Agent Fleet*")))
                (unwind-protect
                    (with-current-buffer buffer
                      (agent-fleet-mode)
                      (agent-fleet-dashboard-refresh)
                      (should (string-match-p "module · 3 agents" (buffer-string)))
                      (should (string-match-p "Worktree:" (buffer-string)))
                      (setq agent-fleet-dashboard--project (file-truename module))
                      (agent-fleet-dashboard-refresh)
                      (should (equal (sort (mapcar #'car tabulated-list-entries) #'string<)
                                     '("t1" "t2" "t3"))))
                  (kill-buffer buffer))))))))))

(ert-deftest fleet-project-subdirs-worktrees-and-nested-repos ()
  (fleet-test-git
    (let ((frontend (expand-file-name "frontend" repo))
          (backend (expand-file-name "backend" repo))
          (nested (expand-file-name "nested" repo)))
      (make-directory frontend)
      (make-directory backend)
      (make-directory nested)
      (fleet-test-git-command repo "worktree" "add" "-b" "worker" wt)
      (fleet-test-git-command nested "init" "-q")
      (dolist (path (list frontend backend wt))
        (should (equal (agent-fleet-project-root-for-cwd path) (file-truename repo))))
      (should (equal (agent-fleet-project-root-for-cwd nested) (file-truename nested)))
      (should (equal (agent-fleet-project-checkout-for-cwd wt) (file-truename wt))))))

(ert-deftest fleet-project-launch-stays-in-linked-checkout ()
  (fleet-test-git
    (fleet-test-git-command repo "worktree" "add" "-b" "worker" wt)
    (let ((subdir (expand-file-name "frontend" wt)) launched prompted)
      (make-directory subdir)
      (let ((default-directory (file-name-as-directory subdir)))
        (cl-letf (((symbol-function 'herdr-core-connect) #'ignore)
                  ((symbol-function 'agent-fleet--read-command) (lambda () '("sh")))
                  ((symbol-function 'agent-fleet-start) (lambda (_argv &rest options) (setq launched (plist-get options :cwd))))
                  ((symbol-function 'agent-fleet-start-minibuffer)
                   (lambda (&optional _) (setq prompted default-directory))))
          (agent-fleet-start-for-project)
          (should (equal launched (file-truename wt)))
          (call-interactively #'agent-fleet-start-for-project)
          (should (equal prompted (file-name-as-directory (file-truename wt)))))))))

(ert-deftest fleet-project-short-labels-disambiguate-without-merging ()
  (let* ((roots '("/home/a/my-app" "/work/b/my-app" "/work/c/unique" "/x/b/my-app" nil))
         (labels (agent-fleet-project--short-labels roots)))
    (should (equal (gethash "/home/a/my-app" labels) "a/my-app"))
    (should (equal (gethash "/work/b/my-app" labels) "work/b/my-app"))
    (should (equal (gethash "/x/b/my-app" labels) "x/b/my-app"))
    (should (equal (gethash "/work/c/unique" labels) "unique"))
    (should (equal (gethash nil labels) "— No Project"))
    (should (= 5 (length (delete-dups (hash-table-values labels)))))))

(ert-deftest fleet-project-cache-reuses-aliases-and-expires ()
  (fleet-test-git
    (let ((agent-fleet-project--cache (make-hash-table :test 'equal))
          (original (symbol-function 'agent-fleet-project--git-context))
          (alias (expand-file-name "alias" dir)) (calls 0))
      (make-symbolic-link repo alias)
      (cl-letf (((symbol-function 'agent-fleet-project--git-context)
                 (lambda (path) (cl-incf calls) (funcall original path))))
        (agent-fleet-project-root-for-cwd repo)
        (agent-fleet-project-root-for-cwd alias)
        (agent-fleet-project-checkout-for-cwd repo)
        (should (= calls 1))
        (maphash (lambda (_key context) (setf (plist-get context :expires) 0)) agent-fleet-project--cache)
        (agent-fleet-project-root-for-cwd repo)
        (should (= calls 2))))))

(ert-deftest fleet-project-negative-cache-can-be-forced-after-git-init ()
  (let ((dir (make-temp-file "fleet-project-none-" t))
        (agent-fleet-project--cache (make-hash-table :test 'equal)))
    (unwind-protect
        (progn
          (should-not (agent-fleet-project-root-for-cwd dir))
          (fleet-test-git-command dir "init" "-q")
          (should-not (agent-fleet-project-root-for-cwd dir))
          (should (equal (agent-fleet-project-checkout-for-cwd dir t) (file-truename dir)))
          (should (equal (agent-fleet-project-root-for-cwd dir) (file-truename dir))))
      (delete-directory dir t))))

(ert-deftest fleet-project-backend-change-invalidates-discovery ()
  (let ((dir (make-temp-file "fleet-project-backend-" t))
        (agent-fleet-project--cache (make-hash-table :test 'equal)))
    (unwind-protect
        (cl-letf (((symbol-function 'agent-fleet-project--git-context) (lambda (_) nil))
                  ((symbol-function 'agent-fleet-project--backend-root-for-cwd)
                   (lambda (_) (if (eq agent-fleet-project-backend 'project) "/one" "/two"))))
          (let ((agent-fleet-project-backend 'project))
            (should (equal (agent-fleet-project-root-for-cwd dir) "/one")))
          (let ((agent-fleet-project-backend 'projectile))
            (should (equal (agent-fleet-project-root-for-cwd dir) "/two"))))
      (delete-directory dir))))

(ert-deftest fleet-project-missing-directory-is-distinct-from-no-project ()
  (let ((dir (make-temp-file "fleet-project-missing-" t)))
    (unwind-protect
        (progn
          (should (eq (plist-get (agent-fleet-project--context dir) :state) 'none))
          (delete-directory dir)
          (should (eq (plist-get (agent-fleet-project--context dir) :state) 'unavailable))
          (let ((record (fleet-test-agent "t1")))
            (setf (plist-get record :cwd) dir)
            (should (string-match-p "Directory unavailable" (agent-fleet-project--directory-note record nil)))
            (with-temp-buffer
              (agent-fleet-details-mode)
              (agent-fleet-details--render record)
              (should (string-match-p "Directory status +Unavailable" (buffer-string))))))
      (when (file-directory-p dir) (delete-directory dir)))))

(ert-deftest fleet-project-tramp-path-never-enters-local-discovery ()
  ;; Load the path handler before trapping filesystem access by discovery.
  (file-remote-p "/ssh:host:/code/repo")
  (cl-letf (((symbol-function 'file-directory-p) (lambda (_) (ert-fail "Resolved remote path locally")))
            ((symbol-function 'file-truename) (lambda (_) (ert-fail "Resolved remote path locally"))))
    (should-not (agent-fleet-project-root-for-cwd "/ssh:host:/code/repo"))
    (should-not (agent-fleet-project-checkout-for-cwd "/ssh:host:/code/repo"))))

(ert-deftest fleet-project-unresolvable-directory-keeps-other-projects-usable ()
  (let ((path (make-temp-name "/tmp/fleet-project-loop-")))
    (unwind-protect
        (progn
          (make-symbolic-link path path)
          (should (eq (plist-get (agent-fleet-project--context path) :state) 'unavailable))
          (should-not (agent-fleet-project-root-for-cwd path)))
      (delete-file path))))

(ert-deftest fleet-project-dashboard-context-and-navigation ()
  (fleet-test-git
    (fleet-test-git-command repo "worktree" "add" "-b" "worker" wt)
    (let* ((front (expand-file-name "frontend" repo))
           (first (fleet-test-agent "t1")) (second (fleet-test-agent "t2"))
           (buffer (get-buffer-create "*Agent Fleet*"))
           (width 120))
      (make-directory front)
      (setf (plist-get first :cwd) front (plist-get second :cwd) wt)
      (unwind-protect
          (fleet-test-model (list first second)
            (cl-letf (((symbol-function 'agent-fleet-dashboard--available-width) (lambda () width)))
             (with-current-buffer buffer
              (agent-fleet-mode)
              (agent-fleet-dashboard-refresh)
              (should (string-match-p (concat "^ repo · 2 agents  "
                                             (regexp-quote (file-name-as-directory (file-truename repo))) "$")
                                     (buffer-string)))
              (should (string-match-p "^   \\./frontend/$" (buffer-string)))
              (should-not (string-match-p "Directory:" (buffer-string)))
              (should (string-match-p (regexp-quote (concat "Worktree: " (file-name-as-directory wt)))
                                     (buffer-string)))
              (should-not (agent-fleet-project--directory-note (list :address "t3" :cwd repo)
                                                             (file-truename repo)))
              (goto-char (point-min))
              (search-forward "repo")
              (should (equal (get-text-property (1- (point)) 'help-echo) (file-truename repo)))
              (agent-fleet-dashboard--goto "t1")
              (forward-line 1)
              (should (equal (tabulated-list-get-id) "t1"))
              (agent-fleet-dashboard-next)
              (should (equal (tabulated-list-get-id) "t2"))
              (agent-fleet-dashboard-previous)
              (should (equal (tabulated-list-get-id) "t1"))
              (should-not (looking-at "   \\./frontend"))
              (setq width 32)
              (agent-fleet-dashboard-refresh)
              (should (equal (tabulated-list-get-id) "t1"))
              (goto-char (point-min))
              (search-forward "repo · 2 agents")
              (forward-line 1)
              (should (looking-at "   ….*repo/$"))
              (should-not (tabulated-list-get-id))
              (should (<= (string-width (buffer-substring (line-beginning-position) (line-end-position))) width))
              (should (equal (get-text-property (+ 3 (point)) 'help-echo) (file-truename repo))))))
        (kill-buffer buffer)))))

(ert-deftest fleet-project-path-labels-preserve-location-and-remote-boundary ()
  (let* ((path (expand-file-name "Projects/my-app" "~/"))
         (label (agent-fleet-project--path-label path)))
    (should (equal label "~/Projects/my-app/"))
    (should (equal (get-text-property 0 'help-echo label) path))
    (dolist (width '(1 8 20))
      (let ((short (agent-fleet-project--path-label "/very/long/路径/frontend" width)))
        (should (<= (string-width short) width))
        (should (string-prefix-p "…" short))
        (should (equal (get-text-property 0 'help-echo short) "/very/long/路径/frontend"))))
    (cl-letf (((symbol-function 'agent-fleet-project--context) (lambda (&rest _) (error "Local discovery")))
              ((symbol-function 'abbreviate-file-name) (lambda (&rest _) (error "Local abbreviation"))))
      (should-not (agent-fleet-project--directory-note (list :address "remote/t1" :cwd path) nil))
      (should-not (agent-fleet-project--directory-note '(:address "remote/t1") nil)))))

(ert-deftest fleet-project-dashboard-filter-reuses-discovery-and-g-refreshes ()
  (fleet-test-git
    (let ((first (fleet-test-agent "t1")) (second (fleet-test-agent "t2"))
          (agent-fleet-project--cache (make-hash-table :test 'equal))
          (original (symbol-function 'agent-fleet-project--git-context)) (calls 0)
          (buffer (get-buffer-create "*Agent Fleet*")))
      (setf (plist-get first :cwd) repo (plist-get second :cwd) repo)
      (unwind-protect
          (fleet-test-model (list first second)
            (with-current-buffer buffer
              (agent-fleet-mode)
              (setq agent-fleet-dashboard--project (file-truename repo))
              (cl-letf (((symbol-function 'agent-fleet-project--git-context)
                         (lambda (path) (cl-incf calls) (funcall original path))))
                (agent-fleet-dashboard-refresh)
                (agent-fleet-dashboard-refresh)
                (should (= calls 1))
                (call-interactively #'agent-fleet-dashboard-refresh)
                (should (= calls 2)))))
        (kill-buffer buffer)))))

(provide 'agent-fleet-project-test)
