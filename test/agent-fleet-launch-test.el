;;; agent-fleet-launch-test.el --- Launch and local attachment regressions -*- lexical-binding: t; -*-
(require 'agent-fleet-core-test)
(require 'agent-fleet-test-git)

(ert-deftest fleet-local-only-selection-dashboard-and-adoption ()
  (fleet-test-model (list (fleet-test-agent "remote/t1") (fleet-test-agent "t1"))
    (should (equal (mapcar (lambda (r) (plist-get r :address)) (agent-fleet-agents t)) '("t1")))
    (let ((reference (agent-fleet-reference (herdr-core-terminal "t1"))) calls
          (buffer (get-buffer-create "*Agent Fleet*")))
      (unwind-protect
          (cl-letf (((symbol-function 'completing-read)
                     (lambda (_prompt choices &rest _)
                       (should (= (length choices) 1))
                       (should (string-match-p "\\[t1\\]" (caar choices)))
                       (caar choices)))
                    ((symbol-function 'herdr-core-request)
                     (lambda (method params &rest _)
                       (push method calls)
                       (should (equal (plist-get params :terminal) "t1"))
                       (herdr-core-terminal "t1"))))
            (should (equal (agent-fleet-read-agent) reference))
            (call-interactively #'agent-fleet-adopt)
            (should (equal calls '("terminal.label" "terminal.get")))
            (with-current-buffer buffer
              (agent-fleet-mode)
              (agent-fleet-dashboard-refresh)
              (should (equal (mapcar #'car tabulated-list-entries) '("t1")))))
        (kill-buffer buffer)))))

(ert-deftest fleet-local-only-operations-reject-routes-and-legacy-identities ()
  ;; Load TRAMP before trapping filesystem access; its initialization reads
  ;; local directories but must not be mistaken for resolving the target cwd.
  (file-remote-p "/ssh:host:/repo")
  (fleet-test-model (list (fleet-test-agent "remote/t1"))
    (cl-letf (((symbol-function 'herdr-core-request) (lambda (&rest _) (ert-fail "Dispatched remote request")))
              ((symbol-function 'herdr-core-request-async) (lambda (&rest _) (ert-fail "Dispatched remote request")))
              ((symbol-function 'file-directory-p) (lambda (&rest _) (ert-fail "Interpreted remote path locally"))))
      (should-error (agent-fleet-reference (herdr-core-terminal "remote/t1")) :type 'user-error)
      (should-error (herdr-core-identity-address (list (herdr-core-id) '("machine-id" "t1") 1)) :type 'user-error)
      (should-error (agent-fleet-resolve "remote/t1") :type 'user-error)
      (dolist (command '(agent-fleet-adopt agent-fleet-attach agent-fleet-observe
                         agent-fleet-prompt agent-fleet-details agent-fleet-interrupt
                         agent-fleet-kill agent-fleet-magit-status agent-fleet-magit-diff))
        (should-error (funcall command "remote/t1") :type 'user-error))
      (should-error (agent-fleet-send-file "remote/t1" "/tmp/context") :type 'user-error)
      (should-error (agent-fleet-start '("sh") :machine "machine-id" :cwd "/remote/repo"))
      (should-error (agent-fleet-start '("sh") :cwd "/ssh:host:/repo") :type 'user-error)
      (should-not (agent-fleet-project-for-agent (herdr-core-terminal "remote/t1"))))))

(ert-deftest fleet-local-only-cleanup-preserves-routed-records ()
  (fleet-test-cleanup (list (fleet-test-agent "remote/t1" "finished")
                            (fleet-test-agent "t1" "finished"))
    (should (= (length agent-fleet-cleanup--items) 1))
    (agent-fleet-cleanup-execute)
    (should (equal (mapcar (lambda (r) (plist-get r :address)) inventory) '("remote/t1")))
    (should (= (cl-count "terminal.rm" calls :test #'equal) 1))))

(ert-deftest fleet-command-input-keeps-spaces-and-template-choices ()
  (let ((agent-fleet--last-command nil)
        (original-space (lookup-key minibuffer-local-completion-map (kbd "SPC")))
        (answer "sh -c \"sleep 60\""))
    (cl-letf (((symbol-function 'agent-fleet--commands)
               (lambda () '(("template: reviewer" . ("reviewer")))))
              ((symbol-function 'completing-read)
               (lambda (&rest _)
                 (should (eq (lookup-key minibuffer-local-completion-map (kbd "SPC"))
                             #'self-insert-command))
                 answer)))
      (should (equal (agent-fleet--read-command) '("sh" "-c" "sleep 60")))
      (should (equal agent-fleet--last-command answer))
      (setq answer "template: reviewer")
      (should (equal (agent-fleet--read-command) '("reviewer")))
      (setq answer "")
      (should-error (agent-fleet--read-command) :type 'user-error))
    (should (eq original-space (lookup-key minibuffer-local-completion-map (kbd "SPC"))))))

(ert-deftest fleet-start-rejection-is-readable-and-retains-original-error ()
  (fleet-test-model nil
    (let ((problem '(herdr-core-request-error :error (:code -32602 :message "bad name")))
          feedback failure)
      (cl-letf (((symbol-function 'herdr-core-request-async)
                 (lambda (_method _params callback &optional _timeout)
                   (funcall callback nil problem)))
                ((symbol-function 'message)
                 (lambda (format &rest args) (setq feedback (apply #'format format args)))))
        (agent-fleet-start '("true") :name "-invalid" :cwd temporary-file-directory
                           :callback (lambda (_record err) (setq failure err))))
      (should (equal feedback "Start -invalid: bad name (not retried)"))
      (should (equal failure problem)))))

(ert-deftest fleet-start-invalid-ack-is-not-reported-as-started ()
  (fleet-test-model nil
    (let (result failure)
      (cl-letf (((symbol-function 'herdr-core-request-async)
                 (lambda (_method _params callback &optional _timeout)
                   (funcall callback '(:address "t1") nil)))
                ((symbol-function 'agent-fleet-dashboard-focus)
                 (lambda (&rest _) (ert-fail "Focused an unacknowledged launch"))))
        (agent-fleet-start '("a") :cwd temporary-file-directory
                           :callback (lambda (r e) (setq result r failure e))))
      (should (equal result '(:address "t1")))
      (should (eq (car failure) 'herdr-core-uncertain)))))

(ert-deftest fleet-file-transfer-rechecks-identity-before-writing ()
  (fleet-test-model (list (fleet-test-agent "t1"))
    (let ((file (make-temp-file "fleet-transfer-" nil nil "bytes")) (calls 0))
      (unwind-protect
          (cl-letf (((symbol-function 'agent-fleet-resolve)
                     (lambda (&rest _)
                       (if (= (cl-incf calls) 1) (herdr-core-terminal "t1")
                         (user-error "Identity changed"))))
                    ((symbol-function 'herdr-core-request) (lambda (&rest _) (ert-fail "Wrote file"))))
            (should-error (agent-fleet-send-file "t1" file) :type 'user-error)
            (should (= calls 2)))
        (delete-file file)))))

(ert-deftest fleet-file-transfer-requires-complete-acknowledgement ()
  (fleet-test-model (list (fleet-test-agent "t1"))
    (let ((file (make-temp-file "fleet-transfer-" nil nil "bytes")))
      (unwind-protect
          (cl-letf (((symbol-function 'agent-fleet-resolve) (lambda (&rest _) (herdr-core-terminal "t1")))
                    ((symbol-function 'herdr-core-request) (lambda (&rest _) '(:path "/artifact" :bytes 1)))
                    ((symbol-function 'agent-fleet-prompt) (lambda (&rest _) (ert-fail "Claimed transfer"))))
            (should-error (agent-fleet-send-file "t1" file) :type 'herdr-core-uncertain))
        (delete-file file)))))

(ert-deftest fleet-observe-and-interactive-viewers-are-separate ()
  (let ((viewer (generate-new-buffer " *viewer*")) (observer (generate-new-buffer " *observer*")))
    (unwind-protect
        (progn
          (dolist (buffer (list viewer observer))
            (with-current-buffer buffer
              (agent-fleet-attach-mode 1)
              (setq agent-fleet-target '(:fleet-identity ("core" "t1" 1))
                    agent-fleet-observe-p (eq buffer observer))))
          (cl-letf (((symbol-function 'process-live-p) (lambda (_) t)))
            (should (eq viewer (agent-fleet-attach--live-buffer '(:fleet-identity ("core" "t1" 1)))))
            (should (eq observer (agent-fleet-attach--live-buffer '(:fleet-identity ("core" "t1" 1)) t)))))
      (kill-buffer viewer) (kill-buffer observer))))

(ert-deftest fleet-observer-quit-restores-each-window-without-core-requests ()
  (save-window-excursion
    (let ((first (generate-new-buffer " *observer-origin-a*"))
          (second (generate-new-buffer " *observer-origin-b*"))
          (observer (generate-new-buffer " *observer-to-close*")))
      (unwind-protect
          (progn
            (dolist (buffer (list first second))
              (with-current-buffer buffer
                (dotimes (_ 100) (insert "Original buffer content\n"))))
            (with-current-buffer observer
              (agent-fleet-attach-mode 1)
              (setq agent-fleet-observe-p t))
            (switch-to-buffer first)
            (goto-char 80)
            (set-window-start nil 24 t)
            (let ((one (selected-window)) (two (split-window-below)))
              (agent-fleet-display-window-open observer)
              (agent-fleet-display-window-open observer)
              (select-window two)
              (switch-to-buffer second)
              (goto-char 120)
              (set-window-start nil 47 t)
              (agent-fleet-display-window-open observer)
              (cl-letf (((symbol-function 'herdr-core-request)
                         (lambda (&rest _) (ert-fail "Observer close must not contact Core"))))
                (agent-fleet-observe-quit))
              (should-not (buffer-live-p observer))
              (should (eq (window-buffer one) first))
              (should (eq (window-buffer two) second))
              (should (= (window-point one) 80))
              (should (= (window-point two) 120))
              (should (= (window-start one) 24))
              (should (= (window-start two) 47))
              (should-not (window-parameter one 'agent-fleet-return-stack))
              (should-not (window-parameter two 'agent-fleet-return-stack))))
        (dolist (buffer (list first second observer))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest fleet-observer-quit-refuses-interactive-attach ()
  (with-temp-buffer
    (agent-fleet-attach-mode 1)
    (should-not (eq (key-binding (kbd "q")) #'agent-fleet-observe-quit))
    (should-error (agent-fleet-observe-quit) :type 'user-error)
    (should (buffer-live-p (current-buffer)))))

(provide 'agent-fleet-launch-test)
